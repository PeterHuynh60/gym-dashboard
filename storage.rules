rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Same pattern as Firestore: users/{userId}/... is private to that user.
    // Covers future use cases like uploaded form-check videos/photos.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
